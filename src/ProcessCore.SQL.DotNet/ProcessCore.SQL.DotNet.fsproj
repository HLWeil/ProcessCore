<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ProcessCore.SQL.DotNet</PackageId>
    <RootNamespace>ProcessCore.SQL.DotNet</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SqliteDriver.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProcessCore.SQL\ProcessCore.SQL.fsproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
</Project>
