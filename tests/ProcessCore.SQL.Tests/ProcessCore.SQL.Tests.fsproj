<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Fixtures.fs" />
    <Compile Include="TableModelTests.fs" />
    <Compile Include="RowCodecTests.fs" />
    <Compile Include="DotNetDriverTests.fs" />
    <Compile Include="RepositoryCrudTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Condition="'$(FABLE_COMPILER)' != 'true'" Include="..\..\src\ProcessCore\ProcessCore.fsproj" />
    <ProjectReference Condition="'$(FABLE_COMPILER_JAVASCRIPT)' == 'true'" Include="..\..\src\ProcessCore\ProcessCore.Javascript.fsproj" />
    <ProjectReference Condition="'$(FABLE_COMPILER_TYPESCRIPT)' == 'true'" Include="..\..\src\ProcessCore\ProcessCore.Javascript.fsproj" />
    <ProjectReference Condition="'$(FABLE_COMPILER_PYTHON)' == 'true'" Include="..\..\src\ProcessCore\ProcessCore.Python.fsproj" />
    <PackageReference Include="Fable.Pyxpecto" />
  </ItemGroup>
</Project>
